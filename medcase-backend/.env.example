APP_NAME=MedCase AI API
APP_VERSION=0.2.0
APP_ENV=development

# Comma-separated list of allowed origins, or "*" for all (default).
# Tighten this for production; leave as "*" for local dev with Expo web/simulator.
CORS_ORIGINS=*

DATABASE_URL=sqlite:///./medcase.db

GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.1-flash-lite

# --- GENEL SİSTEM DOSYALARI ---
.DS_Store
Thumbs.db

# --- PYTHON (Backend) ---
**/__pycache__/
medcase-backend/venv/
medcase-backend/.env
*.pyc
.pytest_cache/

# Evaluation ajan koşularının ham çıktıları (regenerate edilebilir, versiyonlanmaz)
medcase-backend/evaluation/results/

# Human eval kör-çözme anahtarı — hangi Item'ın hangi sisteme ait olduğunu
# gösterir, raterlarla asla paylaşılmamalı; blinded_eval_set.json'dan
# build_blinded_set.py ile (aynı seed'le) yeniden üretilebilir.
medcase-backend/evaluation/human_eval/unblinding_key.json

# LLM-as-a-Judge ham çıktıları — evaluation/results/ ile aynı mantık,
# blinded_eval_set.json + run_judge.py'den yeniden üretilebilir.
medcase-backend/evaluation/llm_judge/judge_scores.json
medcase-backend/evaluation/llm_judge/judge_scores.csv

# Log dosyaları
medcase-backend/logs/

# Büyük Veri Dosyaları (Git'e yükleme)
medcase-backend/data/full_cases.json

# Çalışan SQLite veritabanı — gerçek/test session ve chat geçmişi içerir,
# yalnızca data/cases_subset.json seed verisi versiyonlanmalı (services/seed_cases.py
# app başlangıcında bu dosyadan otomatik SQL'e yükler, medcase.db'ye gerek yok).
medcase-backend/medcase.db

# Resimler (Git'i şişirmesin)
medcase-backend/public/images/*
!medcase-backend/public/images/.gitkeep

# --- NODE.JS / REACT NATIVE (Frontend - İlerisi için) ---
